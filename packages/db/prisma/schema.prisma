// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id     String  @id @default(uuid())
  username    String
  password    String
  orders      Order[]
  positions   Position[]
  maker_fills Fill[]  @relation("maker_user")
  taker_fills Fill[]  @relation("taker_user")
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  FILLED
  PARTIALLY_FILLED
  OPEN
  CANCELLED
}

enum PositionType {
  LONG
  SHORT
}

model Order {
  order_id                        String      @id
  user_id                         String
  market_id                       String
  type                            OrderType
  side                            OrderSide
  price                           BigInt
  slippage                        BigInt
  quantity                        BigInt
  filled                          BigInt
  initial_margin                  BigInt
  leverage                        BigInt
  remaining_order_margin          BigInt
  status                          OrderStatus
  arrival_seq                     BigInt      @unique @default(autoincrement())
  created_at                      DateTime    @default(now())
  updated_at                      DateTime    @updatedAt

  maker_fills Fill[] @relation("maker")
  taker_fills Fill[] @relation("taker")
  user        User   @relation(fields: [user_id], references: [user_id])
}

model Market {
  market_id         String  @id @default(uuid())
  slug              String
  imageUrl          String
  mark_price        BigInt?
  last_traded_price BigInt?
  last_trade_id     String?
}

model Fill {
  quantity   BigInt
  price      BigInt
  created_at DateTime @default(now())
  trade_id   String   @id

  // Foreign keys for Orders
  maker_order_id String
  taker_order_id String

  // Foreign keys for Users
  maker_user_id String
  taker_user_id String

  // Relations mapped to their specific unique foreign keys
  maker_order Order @relation("maker", fields: [maker_order_id], references: [order_id])
  taker_order Order @relation("taker", fields: [taker_order_id], references: [order_id])
  maker_user  User  @relation("maker_user", fields: [maker_user_id], references: [user_id])
  taker_user  User  @relation("taker_user", fields: [taker_user_id], references: [user_id])
}

model Position {
  user_id          String
  market_id        String
  type             PositionType
  quantity         BigInt
  reserved_margin  BigInt
  avg_entry_price  BigInt
  unrealized_pnl   BigInt
  funding_accrued  BigInt

  user User @relation(fields: [user_id], references: [user_id])

  @@id([user_id, market_id])
}

model Collateral {
  user_id         String      @id
  available       BigInt
  reserved        BigInt
}
