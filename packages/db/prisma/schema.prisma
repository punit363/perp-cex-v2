// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id     String     @id @default(uuid())
  username    String
  password    String
  orders      Order[]
  positions   Position[]
  maker_fills Fill[]     @relation("maker_user")
  taker_fills Fill[]     @relation("taker_user")
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  FILLED
  PARTIALLY_FILLED
  OPEN
  CANCELLED
}

enum PositionType {
  LONG
  SHORT
}

enum InsuranceFundEntryType {
  LIQUIDATION_FEE
  LIQUIDATION_SURPLUS
  SHORTFALL_COVER
  UNCOVERED_SHORTFALL
}

enum TradingFeeRole {
  MAKER
  TAKER
}

model Order {
  order_id               String      @id
  user_id                String
  market_id              String
  type                   OrderType
  side                   OrderSide
  price                  BigInt
  slippage               BigInt
  quantity               BigInt
  filled                 BigInt
  initial_margin         BigInt
  initial_fee            BigInt
  leverage               BigInt
  remaining_order_margin BigInt
  remaining_order_fee    BigInt
  status                 OrderStatus
  arrival_seq            BigInt      @unique @default(autoincrement())
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  maker_fills Fill[] @relation("maker")
  taker_fills Fill[] @relation("taker")
  user        User   @relation(fields: [user_id], references: [user_id])
}

model Market {
  market_id         String   @id @default(uuid())
  slug              String
  imageUrl          String
  mark_price        BigInt?
  last_traded_price BigInt?
  last_trade_id     String?
  candles           Candle[]
}

model Candle {
  market_id    String
  start_ms     BigInt
  open         BigInt
  high         BigInt
  low          BigInt
  close        BigInt
  base_volume  BigInt
  quote_volume BigInt
  trade_count  Int

  market Market @relation(fields: [market_id], references: [market_id])

  @@id([market_id, start_ms])
}

model Fill {
  quantity   BigInt
  price      BigInt
  maker_fee  BigInt
  taker_fee  BigInt
  created_at DateTime @default(now())
  trade_id   String   @id

  // Foreign keys for Orders
  maker_order_id String
  taker_order_id String

  // Foreign keys for Users
  maker_user_id String
  taker_user_id String

  // Relations mapped to their specific unique foreign keys
  maker_order Order @relation("maker", fields: [maker_order_id], references: [order_id])
  taker_order Order @relation("taker", fields: [taker_order_id], references: [order_id])
  maker_user  User  @relation("maker_user", fields: [maker_user_id], references: [user_id])
  taker_user  User  @relation("taker_user", fields: [taker_user_id], references: [user_id])
}

model TradingFeeAccount {
  collateral_asset String   @id
  balance          BigInt
  total_maker_fees BigInt
  total_taker_fees BigInt
  updated_at       DateTime @updatedAt
}

model TradingFeeLedgerEntry {
  entry_id         String         @id
  collateral_asset String
  trade_id         String
  order_id         String
  market_id        String
  user_id          String
  role             TradingFeeRole
  amount           BigInt
  balance_after    BigInt
  created_at       DateTime       @default(now())

  @@index([collateral_asset, created_at])
  @@index([user_id, created_at])
  @@index([trade_id])
}

model Position {
  user_id         String
  market_id       String
  type            PositionType
  quantity        BigInt
  reserved_margin BigInt
  avg_entry_price BigInt
  unrealized_pnl  BigInt
  funding_accrued BigInt

  user User @relation(fields: [user_id], references: [user_id])

  @@id([user_id, market_id])
}

model Collateral {
  user_id   String @id
  available BigInt
  reserved  BigInt
}

model InsuranceFund {
  collateral_asset          String   @id
  balance                   BigInt
  total_liquidation_fees    BigInt
  total_liquidation_surplus BigInt
  total_shortfall_covered   BigInt
  total_uncovered_shortfall BigInt
  updated_at                DateTime @updatedAt
}

model InsuranceFundLedgerEntry {
  entry_id             String                 @id
  collateral_asset     String
  market_id            String
  user_id              String
  liquidation_order_id String
  type                 InsuranceFundEntryType
  amount               BigInt
  balance_after        BigInt
  uncovered_shortfall  BigInt
  created_at           DateTime               @default(now())

  @@index([collateral_asset, created_at])
  @@index([liquidation_order_id])
}
