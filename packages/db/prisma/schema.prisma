// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id     String     @id @default(uuid())
  username    String     @unique
  password    String
  orders      Order[]
  positions   Position[]
  maker_fills Fill[]     @relation("maker_user")
  taker_fills Fill[]     @relation("taker_user")
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  FILLED
  PARTIALLY_FILLED
  OPEN
  CANCELLED
}

enum PositionType {
  LONG
  SHORT
}

enum PositionState {
  HEALTHY
  LIQUIDATING
  BANKRUPT
}

enum LiquidationStatus {
  LIQUIDATING
  COMPLETED
  BANKRUPT
}

enum InsuranceFundEntryType {
  LIQUIDATION_FEE
  LIQUIDATION_SURPLUS
  MAKER_FEE_SHARE
  TAKER_FEE_SHARE
  SHORTFALL_COVER
  UNCOVERED_SHORTFALL
  FUNDING_SHORTFALL_COVER
}

enum TradingFeeRole {
  MAKER
  TAKER
}

model Order {
  order_id               String      @id
  user_id                String
  market_id              String
  type                   OrderType
  side                   OrderSide
  price                  BigInt
  slippage               BigInt
  quantity               BigInt
  filled                 BigInt
  initial_margin         BigInt
  initial_fee            BigInt
  leverage               BigInt
  remaining_order_margin BigInt
  remaining_order_fee    BigInt
  status                 OrderStatus
  arrival_seq            BigInt      @unique @default(autoincrement())
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  maker_fills Fill[] @relation("maker")
  taker_fills Fill[] @relation("taker")
  user        User   @relation(fields: [user_id], references: [user_id])
}

model Market {
  market_id         String   @id @default(uuid())
  slug              String   @unique
  imageUrl          String
  mark_price        BigInt?
  last_traded_price BigInt?
  last_trade_id     String?
  trading_halted    Boolean  @default(false)
  maintenance_margin_rate BigInt?
  liquidation_fee_rate BigInt?
  max_leverage BigInt?
  max_liquidation_quantity BigInt?
  funding_fixed_rate BigInt?
  funding_last_rate BigInt?
  last_funding_ms BigInt?
  next_funding_ms BigInt?
  candles           Candle[]
}

model Candle {
  market_id    String
  start_ms     BigInt
  open         BigInt
  high         BigInt
  low          BigInt
  close        BigInt
  base_volume  BigInt
  quote_volume BigInt
  trade_count  Int

  market Market @relation(fields: [market_id], references: [market_id])

  @@id([market_id, start_ms])
}

model Fill {
  quantity   BigInt
  price      BigInt
  maker_fee  BigInt
  taker_fee  BigInt
  created_at DateTime @default(now())
  trade_id   String   @id

  // Foreign keys for Orders
  maker_order_id String
  taker_order_id String

  // Foreign keys for Users
  maker_user_id String
  taker_user_id String

  // Relations mapped to their specific unique foreign keys
  maker_order Order @relation("maker", fields: [maker_order_id], references: [order_id])
  taker_order Order @relation("taker", fields: [taker_order_id], references: [order_id])
  maker_user  User  @relation("maker_user", fields: [maker_user_id], references: [user_id])
  taker_user  User  @relation("taker_user", fields: [taker_user_id], references: [user_id])
}

model TradingFeeAccount {
  collateral_asset String   @id
  balance          BigInt
  total_maker_fees BigInt
  total_taker_fees BigInt
  updated_at       DateTime @updatedAt
}

model TradingFeeLedgerEntry {
  entry_id         String         @id
  collateral_asset String
  trade_id         String
  order_id         String
  market_id        String
  user_id          String
  role             TradingFeeRole
  amount           BigInt
  balance_after    BigInt
  created_at       DateTime       @default(now())

  @@index([collateral_asset, created_at])
  @@index([user_id, created_at])
  @@index([trade_id])
}

model Position {
  user_id         String
  market_id       String
  type            PositionType
  quantity        BigInt
  reserved_margin BigInt
  avg_entry_price BigInt
  unrealized_pnl  BigInt
  funding_accrued BigInt
  state           PositionState @default(HEALTHY)
  liquidation_id  String?
  liquidation_attempts Int @default(0)

  user User @relation(fields: [user_id], references: [user_id])

  @@id([user_id, market_id])
}

model FundingInterval {
  market_id       String
  interval_end_ms BigInt
  index_price     BigInt
  rate            BigInt
  sample_count    Int
  status          String
  total_paid      BigInt
  insurance_used  BigInt
  uncovered_shortfall BigInt
  created_at      DateTime @default(now())

  @@id([market_id, interval_end_ms])
  @@index([market_id, interval_end_ms(sort: Desc)])
}

model FundingPayment {
  market_id       String
  interval_end_ms BigInt
  user_id         String
  amount          BigInt
  requested_amount BigInt
  available_debit BigInt
  margin_debit    BigInt
  insurance_covered BigInt
  uncovered_shortfall BigInt
  created_at      DateTime @default(now())

  @@id([market_id, interval_end_ms, user_id])
  @@index([user_id, market_id, interval_end_ms(sort: Desc)])
}

model Liquidation {
  liquidation_id String @id
  user_id String
  market_id String
  status LiquidationStatus
  initial_quantity BigInt
  remaining_quantity BigInt
  total_filled BigInt
  total_realized_pnl BigInt
  total_liquidation_fee BigInt
  total_user_refund BigInt
  total_shortfall_covered BigInt
  total_uncovered_shortfall BigInt
  attempts Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  attempt_records LiquidationAttempt[]

  @@index([user_id, market_id, created_at])
}

model LiquidationAttempt {
  attempt_id String @id
  liquidation_id String
  user_id String
  market_id String
  status LiquidationStatus
  attempt Int
  initial_quantity BigInt
  filled_quantity BigInt
  remaining_quantity BigInt
  mark_price BigInt
  realized_pnl BigInt
  liquidation_fee BigInt
  user_refund BigInt
  shortfall_covered BigInt
  uncovered_shortfall BigInt
  created_at DateTime @default(now())
  liquidation Liquidation @relation(fields: [liquidation_id], references: [liquidation_id])

  @@index([user_id, market_id, created_at])
}

model ProcessedEngineEvent {
  source_message_id String @id
  processed_at DateTime @default(now())
}

model Collateral {
  user_id   String @id
  available BigInt
  reserved  BigInt
}

model InsuranceFund {
  collateral_asset          String   @id
  balance                   BigInt
  total_liquidation_fees    BigInt
  total_trading_fees        BigInt   @default(0)
  total_liquidation_surplus BigInt
  total_shortfall_covered   BigInt
  total_uncovered_shortfall BigInt
  updated_at                DateTime @updatedAt
}

model InsuranceFundLedgerEntry {
  entry_id             String                 @id
  collateral_asset     String
  market_id            String
  user_id              String
  liquidation_order_id String?
  funding_interval_end_ms BigInt?
  type                 InsuranceFundEntryType
  amount               BigInt
  balance_after        BigInt
  uncovered_shortfall  BigInt
  created_at           DateTime               @default(now())

  @@index([collateral_asset, created_at])
  @@index([liquidation_order_id])
}
