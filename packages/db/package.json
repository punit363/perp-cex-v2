{
  "name": "db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "export": {
    "./": "./index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "db:migrate": "bun --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy --config prisma7.config.ts",
    "db:seed": "bun --env-file=../../.env seed-markets.ts",
    "db:update": "bun run db:migrate && bun run db:seed",
    "seed:markets": "bun seed-markets.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.x.x",
    "@prisma/client": "7.x.x",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "prisma": "7.x.x",
    "commons": "workspace:*"
  }
}
