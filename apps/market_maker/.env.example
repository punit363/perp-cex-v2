# Set this in your shell or copy this file to apps/market_maker/.env.
MM_PASSWORD=replace-with-a-unique-demo-password
MM_API_BASE_URL=http://127.0.0.1:8000/api/v1
MM_USERNAME_PREFIX=demo-mm
MM_MARKETS=BTC-USDT,ETH-USDT

# Three makers each post two bid and two ask levels per market.
MM_MAKERS=3
MM_TAKERS=1
MM_LAYERS=2
MM_HALF_SPREAD_BPS=15
MM_LAYER_STEP_BPS=10
MM_REPRICE_BPS=5
MM_TICK_MS=4000
MM_QUOTE_TTL_MS=30000

# A small crossing trade every third quote cycle; 0 disables trades.
MM_TRADE_EVERY_TICKS=3
MM_ORDER_QUANTITY=0.01
MM_TRADE_QUANTITY=0.005
MM_LEVERAGE=1

# Account total = available + reserved. The bot only tops up the shortfall.
MM_SEED_BALANCES=true
MM_TARGET_COLLATERAL=10000
MM_CANCEL_ON_EXIT=true
MM_MAX_CYCLES=0
