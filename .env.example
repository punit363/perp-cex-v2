# Copy this file to .env and replace the demo-only values before starting Compose.
SITE_ADDRESS=:80
# Change WEB_HTTP_PORT to any free local port; use 80/443 when serving a public domain.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
POSTGRES_USER=apex
POSTGRES_PASSWORD=replace-this-password
POSTGRES_DB=apex
DATABASE_URL=postgresql://apex:replace-this-password@postgres:5432/apex
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_TOKEN=replace-this-with-another-long-random-secret
DEMO_MAX_TOP_UP=10000
# Optional: extra origins for a separately hosted frontend; same-origin traffic needs none.
# CORS_ORIGINS=https://frontend.example.com
# WebSocket origins default to https://SITE_ADDRESS for a public domain.
# WS_ALLOWED_ORIGINS=https://frontend.example.com
